      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|accent|success|danger)$/]",
        "message": "<ProgressBar> tone must be one of 'primary' | 'accent' | 'success' | 'danger'."
